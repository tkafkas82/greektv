# Copy to .env.local for local runs, or add in Vercel -> Settings -> Environment Variables.
# Both variables are optional; the app works without either.

# Lets /api/stream sign the segment URLs it rewrites into a manifest, so it can
# accept them back without widening its host allowlist. Only needed for the few
# streams whose segments live on a different host than their playlist - without
# it, those channels fail over to the greektv.live link instead of relaying.
# Any long random string works:  openssl rand -base64 32
STREAM_PROXY_SECRET=

# Override the local dev port (default 3000). Vercel ignores this.
PORT=3000
