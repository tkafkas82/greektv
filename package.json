{
  "name": "greektv-dial",
  "version": "1.0.0",
  "private": true,
  "description": "All 251 Greek TV channels in one grid, with the current programme and in-app playback.",
  "type": "module",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "start": "node server.mjs",
    "dev": "node server.mjs",
    "refresh:epg-map": "node scripts/refresh-epg-map.mjs",
    "export:m3u": "node scripts/export-m3u.mjs --check",
    "export:m3u:channels": "node scripts/export-m3u.mjs --check --split channel",
    "export:m3u:categories": "node scripts/export-m3u.mjs --check --split category"
  },
  "keywords": ["greek-tv", "epg", "hls", "iptv"],
  "license": "MIT"
}
